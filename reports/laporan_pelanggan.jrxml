<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="laporan_pelanggan" orientation="Landscape"
              pageWidth="842" pageHeight="595" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- QUERY KE DATABASE FERNANDA -->
    <queryString>
        <![CDATA[SELECT id_pelanggan, COALESCE(tanggal, '-') AS tanggal, nama_pelanggan, no_hp, no_polisi, jenis_motor, COALESCE(layanan_dipilih, '-') AS layanan_dipilih, COALESCE(total_biaya, 0) AS total_biaya FROM pelanggan ORDER BY id_pelanggan ASC]]>
    </queryString>

    <field name="id_pelanggan" class="java.lang.Integer"/>
    <field name="tanggal" class="java.lang.String"/>
    <field name="nama_pelanggan" class="java.lang.String"/>
    <field name="no_hp" class="java.lang.String"/>
    <field name="no_polisi" class="java.lang.String"/>
    <field name="jenis_motor" class="java.lang.String"/>
    <field name="layanan_dipilih" class="java.lang.String"/>
    <field name="total_biaya" class="java.lang.Integer"/>

    <!-- VARIABEL UNTUK MENJUMLAHKAN SEMUA TOTAL BIAYA SERVIS -->
    <variable name="GRAND_TOTAL" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{total_biaya}]]></variableExpression>
    </variable>

    <!-- HEADER / KOP LAPORAN -->
    <title>
        <band height="86">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="76" backcolor="#1E3A5F"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="10" width="802" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[BENGKEL MOTOR SIHOMBING]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="38" width="802" height="18" forecolor="#DCE6F1"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN DATA PELANGGAN & RIWAYAT BIAYA SERVIS]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="56" width="802" height="14" forecolor="#B8CCE4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Sistem Informasi Manajemen Pelanggan & Layanan Servis]]></text>
            </staticText>
        </band>
    </title>

    <!-- HEADER TABEL -->
    <columnHeader>
        <band height="28">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="28" backcolor="#2B5B84"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#1E3A5F"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="0" width="32" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="32" y="0" width="105" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tanggal & Jam]]></text>
            </staticText>
            <staticText>
                <reportElement x="137" y="0" width="110" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Nama Pelanggan]]></text>
            </staticText>
            <staticText>
                <reportElement x="247" y="0" width="85" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Nomor HP]]></text>
            </staticText>
            <staticText>
                <reportElement x="332" y="0" width="75" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[No. Polisi]]></text>
            </staticText>
            <staticText>
                <reportElement x="407" y="0" width="85" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Jenis Motor]]></text>
            </staticText>
            <staticText>
                <reportElement x="492" y="0" width="215" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Layanan Servis]]></text>
            </staticText>
            <staticText>
                <reportElement x="707" y="0" width="95" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Biaya]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ISI DATA BARIS (SEMUA CENTER KECUALI LAYANAN SERVIS) -->
    <detail>
        <band height="24">
            <textField textAdjust="StretchHeight">
                <reportElement stretchType="ElementGroupHeight" x="0" y="0" width="32" height="24"/>
                <box topPadding="4" bottomPadding="4"><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id_pelanggan}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement stretchType="ElementGroupHeight" x="32" y="0" width="105" height="24"/>
                <box topPadding="4" bottomPadding="4" leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tanggal}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement stretchType="ElementGroupHeight" x="137" y="0" width="110" height="24"/>
                <box topPadding="4" bottomPadding="4" leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nama_pelanggan}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement stretchType="ElementGroupHeight" x="247" y="0" width="85" height="24"/>
                <box topPadding="4" bottomPadding="4" leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{no_hp}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement stretchType="ElementGroupHeight" x="332" y="0" width="75" height="24"/>
                <box topPadding="4" bottomPadding="4" leftPadding="3" rightPadding="3"><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{no_polisi}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement stretchType="ElementGroupHeight" x="407" y="0" width="85" height="24"/>
                <box topPadding="4" bottomPadding="4" leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{jenis_motor}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement stretchType="ElementGroupHeight" x="492" y="0" width="215" height="24"/>
                <box topPadding="4" bottomPadding="4" leftPadding="5" rightPadding="5"><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{layanan_dipilih}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement stretchType="ElementGroupHeight" x="707" y="0" width="95" height="24"/>
                <box topPadding="4" bottomPadding="4" leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + new java.text.DecimalFormat("#,##0").format($F{total_biaya}).replace(",", ".")]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- FOOTER HALAMAN -->
    <pageFooter>
        <band height="30">
            <line>
                <reportElement x="0" y="5" width="802" height="1" forecolor="#1E3A5F"/>
            </line>
            <textField>
                <reportElement x="0" y="10" width="350" height="18" forecolor="#666666"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Dicetak pada: " + new java.text.SimpleDateFormat("dd-MM-yyyy HH:mm:ss").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="650" y="10" width="152" height="18" forecolor="#666666"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- RINGKASAN GRAND TOTAL SEMUA BIAYA SERVIS -->
    <summary>
        <band height="40">
            <rectangle>
                <reportElement x="0" y="6" width="802" height="30" backcolor="#EBF2F7"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#1E3A5F"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="10" y="6" width="350" height="30" forecolor="#1E3A5F"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Pelanggan Tercatat: " + $V{REPORT_COUNT} + " Orang"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="450" y="6" width="250" height="30" forecolor="#1E3A5F"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL KESELURUHAN BIAYA SERVIS :]]></text>
            </staticText>
            <textField>
                <reportElement x="700" y="6" width="96" height="30" forecolor="#1E3A5F"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + new java.text.DecimalFormat("#,##0").format($V{GRAND_TOTAL} == null ? 0 : $V{GRAND_TOTAL}).replace(",", ".")]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>